{
  "name": "@menu/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply menu --local && wrangler dev --port 3000",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:production": "bun run db:migrate:remote && bun run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "wrangler types --check --env-interface CloudflareBindings && tsc -p tsconfig.json --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply menu --local",
    "db:migrate:remote": "wrangler d1 migrations apply menu --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "@types/node": "26.4.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  }
}
